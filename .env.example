# Copie para .env e ajuste os valores. O .env não vai para o git.

# Postgres do docker-compose.yml (porta 5433 no host)
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5433/portfolio"

# Senha do /admin (Basic Auth; o usuário pode ser qualquer um)
ADMIN_PASSWORD="troque-esta-senha"

# Pasta dos arquivos enviados pelo admin (fotos, capas, CV).
# Local: deixe vazio (usa ./uploads). Railway: monte um Volume em /data e use /data/uploads.
UPLOAD_DIR=""
